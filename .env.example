# DIAGA — Environment Variables
# Salin file ini ke .env dan isi nilainya

# Provider AI: 'anthropic' atau 'gemini'
AI_PROVIDER=anthropic

# Kunci API (JANGAN commit ke repo)
AI_API_KEY=

# Model AI (opsional)
# Anthropic: claude-3-haiku-20240307
# Gemini: gemini-1.5-flash
AI_MODEL=

# URL produksi (untuk sitemap dan CSP)
SITE_URL=https://diaga.vercel.app

# Origin yang diizinkan untuk CORS
ALLOWED_ORIGIN=https://diaga.vercel.app